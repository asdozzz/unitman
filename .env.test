# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Должно совпадать со значением в phpunit.xml.dist: раньше здесь стояло
# 999999 (синтаксис phpunit-bridge < 7, трактуется как «порог в 999999
# депрекейшенов»), а в phpunit.xml.dist — disabled. Значения конфликтовали,
# и итоговое поведение зависело от порядка загрузки.
SYMFONY_DEPRECATIONS_HELPER=disabled
DEFAULT_LOCALE=en
ACCOUNT_DEFAULT_LOCALE=ru

# В тестах подпись обратных вызовов раннера отключена: пустой секрет.
RUNNER_CALLBACK_SECRET=

# Ключ шифрования реквизитов OpenCode (AES-256-GCM, 32 байта в base64).
# Значение тестовое и живёт только в репозитории: base64("test-only-opencode-key-32bytes!!").
# Нужен, чтобы тесты CRUD реквизитов работали с настоящим OpenSslShifr, а не с заглушкой.
OPENCODE_CREDENTIALS_KEY=dGVzdC1vbmx5LW9wZW5jb2RlLWtleS0zMmJ5dGVzISE=
