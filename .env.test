# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
# Synthetic fixture, never use outside tests (allowlisted for WS-10 secret scan).
APP_SECRET='test-app-secret-not-for-production'
# Зеркало выключено по умолчанию и в тестах: тесты зеркала включают его явно.
OPENCODE_WORKSPACE_MIRROR_WRITE=0
# Cutover чтений/записей выключен по умолчанию и в тестах: тесты включают флаги явно.
OPENCODE_WORKSPACE_READ=0
OPENCODE_WORKSPACE_WRITE=0
# Synthetic fixture for the Mediateka upload-token HMAC key. Must be non-empty
# so the container can build UploadTokenCodec; never use outside tests.
MEDIATEKA_UPLOAD_TOKEN_SECRET='test-mediateka-upload-token-secret-not-for-production'
# Workspace attachments: deterministic test limits and allowlist.
MEDIATEKA_WORKSPACE_ALLOWED_EXT='png,jpg,jpeg,gif,webp,txt,md,csv,tsv,json,yaml,yml,xml,log'
MEDIATEKA_WORKSPACE_MAX_FILE_SIZE=52428800
MEDIATEKA_WORKSPACE_MAX_FILES=20
# Должно совпадать со значением в phpunit.xml.dist: раньше здесь стояло
# 999999 (синтаксис phpunit-bridge < 7, трактуется как «порог в 999999
# депрекейшенов»), а в phpunit.xml.dist — disabled. Значения конфликтовали,
# и итоговое поведение зависело от порядка загрузки.
SYMFONY_DEPRECATIONS_HELPER=disabled
DEFAULT_LOCALE=en
ACCOUNT_DEFAULT_LOCALE=ru

# Синтетический origin для тестов CORS/CSRF. Точное совпадение обязательно:
# wildcard с credentialed cookies запрещён.
CORS_ALLOW_ORIGIN=http://localhost:9000
# Secure-флаг refresh-cookie включён и в тестах: контракт cookie не должен
# отличаться от продакшена.
COOKIE_SECURE=true

# Ключ шифрования реквизитов OpenCode (AES-256-GCM, 32 байта в base64).
# Значение тестовое и живёт только в репозитории: base64("test-only-opencode-key-32bytes!!").
# Нужен, чтобы тесты CRUD реквизитов работали с настоящим OpenSslShifr, а не с заглушкой.
OPENCODE_CREDENTIALS_KEY=dGVzdC1vbmx5LW9wZW5jb2RlLWtleS0zMmJ5dGVzISE=

# Ключ шифрования личных токенов (AES-256-GCM, 32 байта в base64).
# Значение тестовое: base64("test-only-personal-token-key-32b").
LICHNIY_TOKEN_CREDENTIALS_KEY=dGVzdC1vbmx5LXBlcnNvbmFsLXRva2VuLWtleS0zMmI=

# WS-9: детерминированный секрет раннера. Синтетический master key, чтобы
# тестовый контейнер строил RunnerSecretGenerator без APP_SECRET-fallback.
# Никогда не использовать вне тестов.
RUNNER_SECRET_MASTER_KEY='test-runner-master-key-not-for-production'

# AI-чат: фиксированные значения для детерминированных тестов.
OPENCODE_API_URL=https://api.opencode.test/v1
AI_CHAT_TIMEOUT=10
AI_CHAT_SESSION_TTL=86400
AI_CHAT_PROVIDER_SESSION_MAX_TTL=300
AI_CHAT_MAX_CONTEXT_MESSAGES=100

# Артефакты хода: детерминированные лимиты и allowlist.
OPENCODE_ARTIFACT_MAX_BYTES=2097152
OPENCODE_ARTIFACT_MAX_FILES=5
OPENCODE_ARTIFACT_MAX_TOTAL_BYTES=8388608
OPENCODE_ARTIFACT_PREVIEW_MAX_BYTES=524288
OPENCODE_ARTIFACT_ALLOWED_EXT=md,txt,json,yaml,yml,csv,log
