<?xml version="1.0" encoding="UTF-8"?>

<!-- Конфигурация под PHPUnit 11 (см. vendor/phpunit/phpunit/phpunit.xsd).
     Изменения относительно прежней версии:
       * убран convertDeprecationsToExceptions — атрибут удалён в PHPUnit 10;
       * listeners заменены на extensions (PHPUnit 10+ не поддерживает listeners);
       * coverage больше не задаёт исходники, за это отвечает секция coverage/source;
       * processUncoveredFiles переименован в includeUncoveredFiles;
       * убран SYMFONY_PHPUNIT_VERSION=9.5 — он противоречил phpunit/phpunit ^11;
       * тесты ищутся по суффиксу Test.php, чтобы в набор не попадали Support/ и
         абстрактные базовые классы и чтобы пустой набор не оставался незамеченным. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- Должно совпадать с .env.test: иначе значение из окружения
             перекрывает конфиг и поведение зависит от порядка загрузки. -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <!-- Суффикс Test.php отбирает только реальные тест-классы:
                 из src/*/Tests в набор попадают ровно *Test.php, а Support/
                 и Abstract*-классы отсекаются без ручных exclude. -->
            <directory suffix="Test.php">src</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <!-- Без глоба: перечислены модули, у которых есть доменная модель.
                 Покрытие считается только по Business/Model. -->
            <directory suffix=".php">src/Account/Business/Model</directory>
            <directory suffix=".php">src/Initialization/Business/Model</directory>
            <directory suffix=".php">src/OpenCode/Business/Model</directory>
            <directory suffix=".php">src/Mediateka/Business/Model</directory>
            <directory suffix=".php">src/Runner/Business/Model</directory>
            <directory suffix=".php">src/Unitman/Business/Model</directory>
        </include>
    </source>

    <coverage includeUncoveredFiles="true" />

    <extensions>
        <!-- Замена удалённому Symfony\Bridge\PhpUnit\SymfonyTestsListener. -->
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension" />
    </extensions>
</phpunit>
