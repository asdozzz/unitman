{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "eventsauce/eventsauce": "*",
        "eventsauce/message-repository-for-doctrine": "*",
        "grpc/grpc": "^1.42",
        "highcore/temporal-bundle": "*",
        "knplabs/github-api": "^3.0",
        "lexik/jwt-authentication-bundle": "^2.18",
        "nelmio/cors-bundle": "^2.4",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpstan/phpdoc-parser": "^1.15",
        "psalm/plugin-symfony": "^5.1",
        "ramsey/uuid": "^4.6",
        "runtime/roadrunner-symfony-nyholm": "*",
        "sensio/framework-extra-bundle": "^6.2",
        "spiral/roadrunner-http": "^2.2",
        "symfony/asset": "6.2.*",
        "symfony/console": "6.2.*",
        "symfony/doctrine-messenger": "6.2.*",
        "symfony/dotenv": "6.2.*",
        "symfony/expression-language": "6.2.*",
        "symfony/flex": "^1.17|^2",
        "symfony/form": "6.2.*",
        "symfony/framework-bundle": "6.2.*",
        "symfony/http-client": "6.2.*",
        "symfony/intl": "6.2.*",
        "symfony/mailer": "6.2.*",
        "symfony/mime": "6.2.*",
        "symfony/monolog-bundle": "^3.0",
        "symfony/notifier": "6.2.*",
        "symfony/process": "6.2.*",
        "symfony/property-access": "6.2.*",
        "symfony/property-info": "6.2.*",
        "symfony/runtime": "6.2.*",
        "symfony/security-bundle": "6.2.*",
        "symfony/serializer": "6.2.*",
        "symfony/string": "6.2.*",
        "symfony/translation": "6.2.*",
        "symfony/twig-bundle": "6.2.*",
        "symfony/uid": "6.2.*",
        "symfony/validator": "6.2.*",
        "symfony/web-link": "6.2.*",
        "symfony/yaml": "6.2.*",
        "temporal/sdk": "^2.5",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0",
        "vimeo/psalm": "^5.2"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check-psalm": "php vendor/bin/psalm",
        "check-phpunit": "php vendor/bin/phpunit",
        "check-deptrac": "php vendor/bin/deptrac",
        "check-account-deptrac": "vendor/bin/deptrac analyze --config-file=./src/Account/deptrac.yaml",
        "check-background-deptrac": "vendor/bin/deptrac analyze --config-file=./src/BackgroundJob/deptrac.yaml",
        "check-runner-deptrac": "vendor/bin/deptrac analyze --config-file=./src/Runner/deptrac.yaml",
        "check-unitman-deptrac": "vendor/bin/deptrac analyze --config-file=./src/Unitman/deptrac.yaml",
        "all-checks": [
            "@check-psalm",
            "@check-phpunit",
            "@check-deptrac",
            "@check-account-deptrac",
            "@check-background-deptrac",
            "@check-runner-deptrac",
            "@check-unitman-deptrac"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.2.*"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "qossmic/deptrac-shim": "^1.0",
        "symfony/browser-kit": "6.2.*",
        "symfony/css-selector": "6.2.*",
        "symfony/debug-bundle": "6.2.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "^6.2",
        "symfony/stopwatch": "6.2.*",
        "symfony/web-profiler-bundle": "6.2.*"
    }
}
