# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration
# Canonical (default) locale. Dictionaries are authored in this language,
# and it is used as the fallback when a translation is missing.
DEFAULT_LOCALE=en
# Locale assigned to newly registered / system accounts.
ACCOUNT_DEFAULT_LOCALE=ru
###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=1555f1d61cd2fe8bd58574a3c87e3d24
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml

DB_NAME=unitman
DB_USER=asd
DB_PASS=123
DB_PORT=5433
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@postgres:5432/${DB_NAME}?serverVersion=13&charset=utf8"
###< doctrine/doctrine-bundle ###

TEMPORAL_UI_PORT=8088
TEMPORAL_DB_PORT=5435
UNITMAN_API_PORT=8082
UNITMAN_FRONT_PORT=8083
UNITMAN_CENTRIFUGO_PORT=8000
APP_DEBUG=false

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=1a0a60af3a1c06431ec9091ca330ae48
# Время жизни refresh-токена в секундах (по умолчанию 30 дней)
REFRESH_TOKEN_TTL=2592000
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

UID=1000
GID=1000

RR_RPC=tcp://127.0.0.1:6001

###> fresh/centrifugo-bundle ###
CENTRIFUGO_API_KEY=secret
CENTRIFUGO_API_ENDPOINT=http://centrifugo:8000/api
CENTRIFUGO_SECRET=admin_secret
###< fresh/centrifugo-bundle ###

MIN_FREE_MEMORY_PERCENT_FOR_RUN_UNIT=10

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Redis работает через ACL: пользователь default отключён (user default off),
# доступ есть только у REDIS_USER/REDIS_USER_PASSWORD. REDIS_PASSWORD оставлен
# для обратной совместимости локальных .env и нигде не используется.
REDIS_PASSWORD=unitman
REDIS_USER=unitman
REDIS_USER_PASSWORD=qwerty123

RAY_HOST=ray@buggregator
RAY_PORT=8000
VAR_DUMPER_FORMAT=server
VAR_DUMPER_SERVER=buggregator:9912
# TCP-хост Buggregator для Monolog-хендлера socket (config/packages/monolog.yaml, when@dev).
# Имя контейнера, а не 127.0.0.1: приложение работает внутри контейнера web.
MONOLOG_SOCKET_HOST=buggregator:9913

XHPROF_BUGGREGATOR_APP_NAME="Symfony Application"
XHPROF_BUGGREGATOR_ENDPOINT=http://buggregator:8000/api/profiler/store
XHPROF_BUGGREGATOR_CLI_ENABLED=false
XHPROF_BUGGREGATOR_HTTP_ENABLED=false
XHPROF_BUGGREGATOR_HTTP_ENABLED_HEADER=

TEMPORAL_VERSION=1.32.2
TEMPORAL_ADMINTOOLS_VERSION=1.32.2
TEMPORAL_UI_VERSION=2.56.1

# Подключение приложения к Temporal: адрес фронтенда и очередь воркера.
# Читаются в config/packages/temporal.yaml и src/App/di.php; дублируются
# в common-services.yml как переменные окружения контейнера web.
TEMPORAL_CLI_ADDRESS=temporal:7233
TEMPORAL_WORKER_QUEUE=unitman-mono-queue

###> minio ###
# Авторизация MinIO: секреты в .env.local (не коммитить)
MINIO_ROOT_USER=unitman
MINIO_ROOT_PASSWORD=change-me-in-env-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Внутренний адрес — из контейнера web
MINIO_ENDPOINT=http://minio:9000
# Публичный адрес — для presigned-ссылок, которые открывает браузер
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT_CONSOLE=http://localhost:9001
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true
###< minio ###

###> mediateka ###
MEDIATEKA_BUCKET=unitman-mediateka
MEDIATEKA_PRESIGN_TTL=3600
# 200 МБ
MEDIATEKA_MAX_FILE_SIZE=209715200
###< mediateka ###
