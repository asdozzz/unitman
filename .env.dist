# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration
#
# --- Secrets -----------------------------------------------------------------
# Copy this file to .env, then either run ./install.sh from the release bundle
# or generate each empty value manually:
#   openssl rand -hex 32       hex secrets: APP_SECRET, DB_PASS, JWT_PASSPHRASE,
#                              OAUTH_STATE_SECRET, MEDIATEKA_UPLOAD_TOKEN_SECRET,
#                              RUNNER_SECRET_MASTER_KEY, REDIS/MINIO passwords
#   openssl rand -base64 32    base64 secrets: OPENCODE_CREDENTIALS_KEY,
#                              LICHNIY_TOKEN_CREDENTIALS_KEY
# Never commit a real .env; keep it at mode 600 (chmod 600 .env).
# Every secret placeholder below is intentionally empty.
# -----------------------------------------------------------------------------
# Canonical (default) locale. Dictionaries are authored in this language,
# and it is used as the fallback when a translation is missing.
DEFAULT_LOCALE=en
# Locale assigned to newly registered / system accounts.
ACCOUNT_DEFAULT_LOCALE=ru
###> symfony/framework-bundle ###
APP_ENV=dev
# Generated by install.sh / `openssl rand -hex 32`. Never commit a real value.
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml

DB_NAME=unitman
DB_USER=unitman
# Generated by install.sh / `openssl rand -hex 32`. Never commit a real value.
DB_PASS=
DB_PORT=5433
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@postgres:5432/${DB_NAME}?serverVersion=13&charset=utf8"
###< doctrine/doctrine-bundle ###

TEMPORAL_UI_PORT=8088
TEMPORAL_DB_PORT=5435
# Published infra ports bind to loopback by default. Create an explicit opt-in
# by setting a *_BIND_HOST to 0.0.0.0 only behind a firewall/reverse proxy.
TEMPORAL_BIND_HOST=127.0.0.1
TEMPORAL_UI_BIND_HOST=127.0.0.1
MINIO_BIND_HOST=127.0.0.1
MINIO_CONSOLE_BIND_HOST=127.0.0.1
CENTRIFUGO_BIND_HOST=127.0.0.1
UNITMAN_API_PORT=8082
UNITMAN_FRONT_PORT=8083
UNITMAN_CENTRIFUGO_PORT=8000
APP_DEBUG=false

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Generated by install.sh / `openssl rand -hex 32`; encrypts the JWT keys.
JWT_PASSPHRASE=
# Время жизни refresh-токена в секундах (по умолчанию 30 дней)
REFRESH_TOKEN_TTL=2592000
###< lexik/jwt-authentication-bundle ###

###> refresh cookie ###
# Secure-флаг refresh-cookie. В продакшене ОБЯЗАТЕЛЬНО true (значение по
# умолчанию). Выключать только для локальной разработки по http и только
# явно: COOKIE_SECURE=false. Факт override пишется в лог (только имя).
COOKIE_SECURE=true
###< refresh cookie ###

###> nelmio/cors-bundle ###
# Точный список origin фронтенда через запятую (не regex, не '*').
# С credentialed cookies браузер требует конкретный origin.
CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8033,http://localhost:8083
###< nelmio/cors-bundle ###

UID=1000
GID=1000

RR_RPC=tcp://127.0.0.1:6001

###> background jobs ###
# 1 — 15 задач выполняются тремя RoadRunner-сервисами-планировщиками
#     (background_jobs_projections / producers / timers);
# 0 — прежний режим: отдельный сервис на каждую задачу.
# Откат: BACKGROUND_JOB_SCHEDULER=0, затем app:jobs stop && app:jobs start.
BACKGROUND_JOB_SCHEDULER=1
###< background jobs ###

###> opencode credentials ###
# Мастер-ключ шифрования API-ключей OpenCode (AES-256-GCM).
# base64 от 32 случайных байт: php -r "echo base64_encode(random_bytes(32));"
# В прод задаётся секретом окружения, в репозиторий попадать не должен.
# Пустое значение ОТКЛЮЧАЕТ управление реквизитами OpenCode (эндпоинты вернут ошибку).
OPENCODE_CREDENTIALS_KEY=
###< opencode credentials ###

###> ai chat ###
# Базовый URL OpenAI-совместимого API. Используется только как fallback:
# URL из реквизитов пользователя имеет приоритет.
OPENCODE_API_URL=https://api.opencode.ai/v1
# Таймаут исходящего запроса chat completions, секунды.
AI_CHAT_TIMEOUT=60
# TTL пользовательской AI-сессии, секунды (по умолчанию 24 часа).
AI_CHAT_SESSION_TTL=86400
# Максимальный TTL provider-сессии, секунды; ограничивает политику провайдера.
AI_CHAT_PROVIDER_SESSION_MAX_TTL=300
# Сколько последних сообщений передавать в контекст upstream.
AI_CHAT_MAX_CONTEXT_MESSAGES=100
###< ai chat ###

###> personal storage tokens ###
# Мастер-ключ шифрования личных токенов GitLab/GitHub (AES-256-GCM).
# base64 от 32 случайных байт: php -r "echo base64_encode(random_bytes(32));"
# В прод задаётся секретом окружения, в репозиторий попадать не должен.
# Пустое значение отключает работу с личными токенами.
LICHNIY_TOKEN_CREDENTIALS_KEY=
###< personal storage tokens ###

###> notifications / web push ###
# VAPID-ключи для браузерного Push API. Публичный ключ отдаётся фронтенду,
# приватный используется только сервером.
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Ретеншн уведомлений в днях: информационные и требующие прочтения.
NOTIFICATION_INFO_RETENTION_DAYS=7
NOTIFICATION_ACTIONABLE_RETENTION_DAYS=90
###< notifications / web push ###

###> runner registry ###
# Мастер-ключ для детерминированного секрета раннера:
# secret = hmac_sha256(runnerId, RUNNER_SECRET_MASTER_KEY).
# Значение — 64 hex-символа (32 случайных байта). Один и тот же ключ должен
# использоваться backend-ролями и edge-progress.
# Генерируется install.sh / `openssl rand -hex 32`.
# Ротация: make runner-secret-rotate — инвалидирует все per-runner секреты,
# после чего каждый раннер нужно переинициализировать (runner init).
# Пустое значение недопустимо: edge-progress не стартует без явного ключа
# (fail-closed), fallback на APP_SECRET отключён.
# Секрет не хранится в БД и не логируется; отдаётся один раз при регистрации.
RUNNER_SECRET_MASTER_KEY=
# Публичный адрес реестра раннеров, который backend отдаёт при регистрации.
UNITMAN_REGISTRY_PUBLIC_ADDRESS=
# Публичный порт реестра в ответе регистрации v2 (дефолт — 5000).
UNITMAN_REGISTRY_PUBLIC_PORT=5000
###< runner registry ###

###> fresh/centrifugo-bundle ###
# Секреты задавайте в .env.local (openssl rand -hex 32), не коммитьте.
# Пустые значения = centrifugo не стартует (fail-closed).
CENTRIFUGO_API_KEY=
CENTRIFUGO_API_ENDPOINT=http://centrifugo:8000/api
CENTRIFUGO_SECRET=
# Обязательный список origin фронта через запятую; "*" запрещён.
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000
###< fresh/centrifugo-bundle ###

MIN_FREE_MEMORY_PERCENT_FOR_RUN_UNIT=10

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@unitman.local
MAILER_FROM_NAME=Unitman
###< symfony/mailer ###

###> email verification ###
EMAIL_VERIFICATION_TTL=900
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN=60
###< email verification ###

###> oauth ###
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8082
OAUTH_FRONTEND_URL=http://localhost:8083
# Generated by install.sh / `openssl rand -hex 32`. Never commit a real value.
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL=600
OAUTH_EXCHANGE_CODE_TTL=120
###< oauth ###

# Redis работает через ACL: пользователь default отключён (user default off),
# доступ есть только у REDIS_USER/REDIS_USER_PASSWORD. REDIS_PASSWORD оставлен
# для обратной совместимости локальных .env и нигде не используется.
# Оба пароля генерируются install.sh / `openssl rand -hex 32`.
REDIS_PASSWORD=
REDIS_USER=unitman
REDIS_USER_PASSWORD=

RAY_HOST=ray@buggregator
RAY_PORT=8000
VAR_DUMPER_FORMAT=server
VAR_DUMPER_SERVER=buggregator:9912
# TCP-хост Buggregator для Monolog-хендлера socket (config/packages/monolog.yaml, when@dev).
# Имя контейнера, а не 127.0.0.1: приложение работает внутри контейнера web.
MONOLOG_SOCKET_HOST=buggregator:9913

XHPROF_BUGGREGATOR_APP_NAME="Symfony Application"
XHPROF_BUGGREGATOR_ENDPOINT=http://buggregator:8000/api/profiler/store
XHPROF_BUGGREGATOR_CLI_ENABLED=false
XHPROF_BUGGREGATOR_HTTP_ENABLED=false
XHPROF_BUGGREGATOR_HTTP_ENABLED_HEADER=

TEMPORAL_VERSION=1.32.2
TEMPORAL_ADMINTOOLS_VERSION=1.32.2
TEMPORAL_UI_VERSION=2.56.1

# Подключение приложения к Temporal: адрес фронтенда и очередь воркера.
# Читаются в config/packages/temporal.yaml и src/App/di.php; дублируются
# в common-services.yml как переменные окружения контейнера web.
TEMPORAL_CLI_ADDRESS=temporal:7233
TEMPORAL_WORKER_QUEUE=unitman-mono-queue
# Публичный порт Temporal, который backend отдаёт раннеру при регистрации v2.
UNITMAN_TEMPORAL_PUBLIC_PORT=7233

###> minio ###
# Авторизация MinIO: секреты в .env.local (не коммитить)
MINIO_ROOT_USER=unitman
# Generated by install.sh / `openssl rand -hex 32`. Never commit a real value.
MINIO_ROOT_PASSWORD=
MINIO_BIND_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001
# Внутренний адрес — из контейнера web
MINIO_ENDPOINT=http://minio:9000
# Публичный адрес — для presigned-ссылок, которые открывает браузер
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT_CONSOLE=http://localhost:9001
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true
###< minio ###

###> mediateka ###
MEDIATEKA_BUCKET=unitman-mediateka
MEDIATEKA_PRESIGN_TTL=3600
# 200 МБ
MEDIATEKA_MAX_FILE_SIZE=209715200
# HMAC-ключ upload-токенов (не APP_SECRET). Генерируется install.sh /
# `openssl rand -hex 32`. Пустое значение = fail-closed при сборке контейнера.
MEDIATEKA_UPLOAD_TOKEN_SECRET=
###< mediateka ###

###> edge service (Go) ###
# Go-edge запускается только с профилем: docker compose --profile edge up -d
# Дефолтный стек и API на UNITMAN_API_PORT (8082) этими переменными не меняются.

# Host-порт канареечного шлюза (edge-gateway). Через него проверяются
# progress/webhook/media; всё остальное уходит в PHP на 8082.
EDGE_GATEWAY_PORT=8090

# Опциональные прямые host-порты edge-сервисов для smoke.
# Пустое значение = порт наружу не публикуется (сервис доступен только внутри
# сети compose). Чтобы включить прямой доступ, раскомментируйте соответствующие
# ports: в common-services.yml.
EDGE_PROGRESS_PORT=
EDGE_MEDIA_PORT=
# Прямой порт экспортёра метрик (edge-telemetry); нужен для отладки scrape.
EDGE_TELEMETRY_PORT=

# GID группы docker-сокета для edge-telemetry (монтируется read-only).
# Узнать на хосте: stat -c '%g' /var/run/docker.sock
# Пусто = используется 999 (${DOCKER_GID:-999} в compose).
DOCKER_GID=

# Секреты Git-провайдеров для edge-webhook. Пусто = запросы провайдера
# отклоняются с 403 (fail-closed). Боевые значения задавайте только в
# .env.local или секретах окружения, не коммитьте.
#   GitLab: X-Gitlab-Token
#   GitHub: X-Hub-Signature-256 = sha256=<hex hmac>
#   Gitea: X-Gitea-Signature = <hex hmac>
#   Forgejo: X-Forgejo-Signature = <hex hmac>
#   GitFlic: X-Gitflic-Signature = <hex hmac> или X-Gitflic-Token = <secret>
#   GitVerse: Authorization: Bearer <secret> или X-Gitverse-Signature = <hex hmac>
#   Bitbucket: X-Hub-Signature = sha256=<hex hmac>
GITLAB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
GITEA_WEBHOOK_SECRET=
FORGEJO_WEBHOOK_SECRET=
GITFLIC_WEBHOOK_SECRET=
GITVERSE_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=
# Явный escape hatch только для dev: пустые секреты принимаются, если здесь
# ровно "true" И APP_ENV=dev/local/test. В prod всегда false.
WEBHOOK_ALLOW_UNSIGNED=false
# Лимит запросов edge-webhook на проект/провайдер (0 отключает лимит).
WEBHOOK_RATE_LIMIT_PER_SECOND=100
# Куда edge-webhook проксирует события: существующий PHP/RoadRunner.
PHP_WEBHOOK_BASE_URL=http://web:8080

# Явные S3-кредиты для edge-media. Пусто = compose подставляет
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (см. common-services.yml).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
###< edge service (Go) ###
